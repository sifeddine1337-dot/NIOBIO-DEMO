# Copy these values into your hosting environment (Render/Railway/VPS) or set
# them in the shell before running `npm run start`.
# The server reads real environment variables only — it does not load this file.

# Port the API listens on. Also the target of the Vite dev proxy.
PORT=4000

# Password for the /admin control panel. REQUIRED in production: without it the
# server falls back to the development password "admin123" and logs a warning.
ADMIN_PASSWORD=change-me-before-going-live

# Optional: where the JSON store and the uploaded images are written.
# Defaults are server/data and server/uploads.
# DATA_DIR=/var/lib/coprochim/data
# UPLOAD_DIR=/var/lib/coprochim/uploads